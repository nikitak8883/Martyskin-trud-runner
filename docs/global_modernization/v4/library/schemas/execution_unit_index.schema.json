{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/modernization/v4/execution-unit-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "generated_at", "basis", "source_ledger", "execution_ledger", "status_values", "decisions", "units"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "basis": {"$ref": "#/$defs/basis"},
    "source_ledger": {"$ref": "#/$defs/sourceLedger"},
    "execution_ledger": {"$ref": "#/$defs/executionLedger"},
    "status_values": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["complete", "ready", "planned", "blocked", "conditional"]}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "documentation_basis_head", "runtime_checkpoint", "external_package_sha256", "source_work_package_index"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "documentation_basis_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runtime_checkpoint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "external_package_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "source_work_package_index": {"const": "docs/global_modernization/v3/WORK_PACKAGE_INDEX.yaml"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"},
        "status": {"enum": ["accepted", "blocked", "deferred"]},
        "decision": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {"properties": {"decision": {"type": "null"}}},
          "else": {"properties": {"decision": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "sourceLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "complete", "pending", "blocked", "conditional", "mandatory_total", "mandatory_remaining"],
      "properties": {
        "total": {"type": "integer", "minimum": 0}, "complete": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0},
        "conditional": {"type": "integer", "minimum": 0}, "mandatory_total": {"type": "integer", "minimum": 0},
        "mandatory_remaining": {"type": "integer", "minimum": 0}
      }
    },
    "executionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatory_units_total", "complete", "ready", "planned", "blocked", "mandatory_remaining", "conditional_units_total"],
      "properties": {
        "mandatory_units_total": {"type": "integer", "minimum": 0}, "complete": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0}, "planned": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}, "mandatory_remaining": {"type": "integer", "minimum": 0},
        "conditional_units_total": {"type": "integer", "minimum": 0}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "status", "source_packages", "depends_on", "gates", "objective"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Za-z0-9._-]*$"},
        "phase": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "C1", "C2"]},
        "status": {"enum": ["complete", "ready", "planned", "blocked", "conditional"]},
        "source_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2}\\.[0-9]+$"}},
        "source_slice": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Za-z0-9._-]*$"}},
        "optional_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Za-z0-9._-]*$"}},
        "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["D4", "P4_STATIC", "ANDROID_PREFLIGHT", "P4", "M2_PLUS", "QA7", "RC2", "LIVE_PARITY"]}},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"}},
        "condition": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {"required": ["blockers"]},
          "else": {"not": {"required": ["blockers"]}}
        },
        {
          "if": {"properties": {"status": {"const": "conditional"}}, "required": ["status"]},
          "then": {"required": ["condition"]},
          "else": {"not": {"required": ["condition"]}}
        }
      ]
    }
  }
}
