{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/modernization/v4/dev-event.schema.json",
  "title": "MTR bounded development event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "epoch", "tick", "code"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "code": {
      "enum": [
        "session.transition.accepted",
        "session.transition.rejected",
        "session.reset.begin",
        "session.reset.end",
        "session.epoch.changed",
        "input.action",
        "collision.event",
        "powerup.event",
        "asset.load.start",
        "asset.load.complete",
        "asset.load.error",
        "qa.marker"
      ]
    },
    "state": {"type": "string", "maxLength": 64},
    "reason": {"type": "string", "maxLength": 96},
    "payload": {"$ref": "#/$defs/jsonValue"}
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {"type": ["number", "boolean", "null"]},
        {"type": "string", "maxLength": 256},
        {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "maxProperties": 24, "propertyNames": {"maxLength": 256}, "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  },
  "x-mtr-runtime-max-depth": 4,
  "x-mtr-runtime-max-payload-nodes": 512,
  "x-mtr-runtime-max-payload-bytes": 16384,
  "x-mtr-runtime-max-export-bytes": 65536
}
