{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtr.local/schemas/m04/contact_sheet_index.schema.json",
  "title": "MTR M04-B manifest-linked contact sheet index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaPath",
    "generator",
    "source",
    "materialization",
    "classificationPolicy",
    "summary",
    "categories"
  ],
  "properties": {
    "schema": {"const": "mtr.asset_contact_sheets.v1"},
    "schemaPath": {"const": "docs/global_modernization/v3/M04/schemas/contact_sheet_index.schema.json"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "pillowVersion", "deterministic", "runtimeAssetsMutated", "runtimeMetadataMutated"],
      "properties": {
        "id": {"const": "m04-b-contact-sheets.v1"},
        "path": {"const": "tools/codex/render_m04_b_contact_sheets.py"},
        "pillowVersion": {"type": "string", "minLength": 1},
        "deterministic": {"const": true},
        "runtimeAssetsMutated": {"const": false},
        "runtimeMetadataMutated": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atlasManifest", "atlasManifestSha256", "contentIdentity", "logicalContentVersion", "sourcePayloadSha256"],
      "properties": {
        "atlasManifest": {"const": "assets/resources/config/atlas_manifest.json"},
        "atlasManifestSha256": {"$ref": "#/$defs/sha256"},
        "contentIdentity": {"const": "assets/resources/config/content_identity.json"},
        "logicalContentVersion": {"type": "string", "pattern": "^mtr-v3-source-[0-9a-f]{12}$"},
        "sourcePayloadSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "outputRoot", "regenerateCommand", "checkCommand", "html"],
      "properties": {
        "policy": {"const": "local_qa_evidence_not_runtime_not_committed"},
        "outputRoot": {"const": "temp/m04-b-contact-sheets"},
        "regenerateCommand": {"type": "string", "minLength": 1},
        "checkCommand": {"type": "string", "minLength": 1},
        "html": {"$ref": "#/$defs/artifact"}
      }
    },
    "classificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requiredCategories",
        "coverage",
        "vfxRule",
        "hudRule",
        "menuRule",
        "runnerRule",
        "bonusesRule",
        "obstaclesRule",
        "backgroundsRule"
      ],
      "properties": {
        "version": {"const": 1},
        "requiredCategories": {
          "type": "array",
          "prefixItems": [
            {"const": "hud"},
            {"const": "menu"},
            {"const": "runner"},
            {"const": "bonuses"},
            {"const": "obstacles"},
            {"const": "backgrounds"},
            {"const": "vfx"}
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "coverage": {"const": "every governed PNG/JPG exactly once"},
        "vfxRule": {"type": "string", "minLength": 1},
        "hudRule": {"type": "string", "minLength": 1},
        "menuRule": {"type": "string", "minLength": 1},
        "runnerRule": {"type": "string", "minLength": 1},
        "bonusesRule": {"type": "string", "minLength": 1},
        "obstaclesRule": {"type": "string", "minLength": 1},
        "backgroundsRule": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryCount", "assetCount", "sheetCount", "unclassifiedCount", "duplicateClassificationCount"],
      "properties": {
        "categoryCount": {"const": 7},
        "assetCount": {"type": "integer", "minimum": 1},
        "sheetCount": {"type": "integer", "minimum": 7},
        "unclassifiedCount": {"const": 0},
        "duplicateClassificationCount": {"const": 0}
      }
    },
    "categories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/category"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes", "width", "height", "assetCount"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+-[0-9]{2}$"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "assetCount": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "width",
        "height",
        "mode",
        "hasAlpha",
        "alphaBBox",
        "atlasId",
        "atlasManifestPointer",
        "ownershipScope",
        "ownershipManifestPointer",
        "provenance",
        "sheetId",
        "cellIndex"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "minLength": 1},
        "hasAlpha": {"type": "boolean"},
        "alphaBBox": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "atlasId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "atlasManifestPointer": {"type": "string", "pattern": "^/atlas_groups/[0-9]+$"},
        "ownershipScope": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "ownershipManifestPointer": {"type": "string", "pattern": "^/ownership_scopes/[0-9]+$"},
        "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "sheetId": {"type": "string", "pattern": "^[a-z]+-[0-9]{2}$"},
        "cellIndex": {"type": "integer", "minimum": 0, "maximum": 63}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "assetCount",
        "sheetCount",
        "sourceDigest",
        "atlasIds",
        "ownershipScopes",
        "provenance",
        "sheets",
        "assets"
      ],
      "properties": {
        "id": {"enum": ["hud", "menu", "runner", "bonuses", "obstacles", "backgrounds", "vfx"]},
        "label": {"type": "string", "minLength": 1},
        "assetCount": {"type": "integer", "minimum": 1},
        "sheetCount": {"type": "integer", "minimum": 1},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "atlasIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "ownershipScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "sheets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sheet"}},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
      }
    }
  }
}
