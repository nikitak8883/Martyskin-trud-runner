{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/quality/v1/quality-fixture-suite.schema.json",
  "title": "MTR quality adapter fixture suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "suite_kind",
    "defaults",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "mtr.quality_fixture_suite"
    },
    "suite_kind": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "defaults": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "description",
        "input",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "envelope",
                "error"
              ]
            },
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED"
              ]
            },
            "error_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            "finding_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "envelope"
                  }
                }
              },
              "then": {
                "required": [
                  "status"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "error"
                  }
                }
              },
              "then": {
                "required": [
                  "error_code"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
