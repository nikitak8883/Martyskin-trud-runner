{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/quality/v1/quality-gate-report.schema.json",
  "title": "MTR typed quality gate report",
  "description": "Atomic, source-bound execution report emitted by the M01.3 quality runner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "run_id",
    "gate_id",
    "generated_at",
    "status",
    "source",
    "config",
    "schema_engine",
    "duration_ms",
    "steps",
    "artifacts",
    "findings",
    "decision_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "mtr.quality_gate_report"
    },
    "run_id": {
      "$ref": "#/$defs/safe_id"
    },
    "gate_id": {
      "$ref": "#/$defs/safe_id"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "config": {
      "$ref": "#/$defs/config_identity"
    },
    "schema_engine": {
      "$ref": "#/$defs/schema_engine"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/step_result"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "matches_expected": {
                "const": true
              },
              "stable_during_run": {
                "const": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "dirty": {
                      "const": true
                    }
                  },
                  "required": [
                    "dirty"
                  ]
                },
                "then": {
                  "properties": {
                    "dirty_authorized": {
                      "const": true
                    }
                  }
                }
              }
            ]
          },
          "steps": {
            "items": {
              "if": {
                "properties": {
                  "mandatory": {
                    "const": true
                  }
                },
                "required": [
                  "mandatory"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "findings": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "blocking"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "project_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "expected_commit",
        "matches_expected",
        "content_version",
        "dirty",
        "dirty_authorized",
        "stable_during_run"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "matches_expected": {
          "type": "boolean"
        },
        "content_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_authorized": {
          "type": "boolean"
        },
        "stable_during_run": {
          "type": "boolean"
        }
      }
    },
    "config_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "schema_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "draft",
        "isolated",
        "lock_sha256",
        "python_version"
      ],
      "properties": {
        "name": {
          "const": "jsonschema"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "draft": {
          "const": "2020-12"
        },
        "isolated": {
          "const": true
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "finished_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "resolved_executable",
        "arguments",
        "working_directory",
        "timeout_seconds",
        "expected_exit_codes"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "resolved_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "$ref": "#/$defs/project_relative_path"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "relative_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stdout",
            "stderr",
            "native_report",
            "declared"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "blocking",
        "step_id",
        "path",
        "field",
        "expected",
        "actual",
        "suggested_fix"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,128}$"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKER"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "step_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "expected": true,
        "actual": true,
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "enabled",
        "status",
        "exit_code",
        "timed_out",
        "command",
        "timing",
        "artifacts",
        "evidence_envelope",
        "findings",
        "decision_reasons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "mandatory": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "SKIPPED"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "evidence_envelope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://schemas.mtr.local/quality/v1/quality-evidence-envelope.schema.json"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "decision_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              },
              "timed_out": {
                "const": false
              },
              "exit_code": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "SKIPPED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": false
              },
              "timed_out": {
                "const": false
              },
              "exit_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timed_out": {
                "const": true
              }
            },
            "required": [
              "timed_out"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "BLOCKED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "contains": {
                  "properties": {
                    "blocking": {
                      "const": true
                    }
                  },
                  "required": [
                    "blocking"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }
}
