{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/quality/v1/quality-gate-config.schema.json",
  "title": "MTR typed quality gate configuration",
  "description": "Shell-free, project-contained command registry consumed by the M01.3 quality runner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "gate_id",
    "artifact_directory",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "mtr.quality_gate_config"
    },
    "gate_id": {
      "$ref": "#/$defs/safe_id"
    },
    "artifact_directory": {
      "$ref": "#/$defs/project_relative_path"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "project_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "identity",
        "profile"
      ],
      "properties": {
        "platform": {
          "enum": [
            "source",
            "static",
            "web",
            "android-emulator",
            "android-device"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_report_path",
        "tool_path",
        "target",
        "strict",
        "flags",
        "applicable"
      ],
      "properties": {
        "native_report_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "tool_path": {
          "$ref": "#/$defs/project_relative_path"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "strict": {
          "type": "boolean"
        },
        "flags": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "applicable": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "enabled",
        "executable",
        "arguments",
        "working_directory",
        "timeout_seconds",
        "expected_exit_codes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "mandatory": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "arguments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "working_directory": {
          "$ref": "#/$defs/project_relative_path"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "artifact_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/project_relative_path"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
