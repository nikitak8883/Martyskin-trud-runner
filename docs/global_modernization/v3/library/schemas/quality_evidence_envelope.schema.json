{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/quality/v1/quality-evidence-envelope.schema.json",
  "title": "MTR canonical quality evidence envelope",
  "description": "Versioned, source-bound, fail-closed evidence emitted by an approved adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "evidence_id",
    "adapter",
    "source_report",
    "source",
    "target",
    "tool",
    "timing",
    "status",
    "mandatory",
    "applicable",
    "fresh",
    "metrics",
    "findings",
    "decision_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "mtr.quality_evidence_envelope"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "source_report": {
      "$ref": "#/$defs/source_report"
    },
    "source": {
      "$ref": "#/$defs/source_identity"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "applicable": {
      "type": "boolean"
    },
    "fresh": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "fresh": {
            "const": true
          },
          "findings": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "blocking"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mtr\\.quality_adapter\\.[a-z0-9_]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "schema_name": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "content_version"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "content_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "identity",
        "profile"
      ],
      "properties": {
        "platform": {
          "enum": [
            "source",
            "static",
            "web",
            "android-emulator",
            "android-device"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "command_id",
        "strict",
        "flags"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "strict": {
          "type": "boolean"
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "blocking",
        "path",
        "field",
        "expected",
        "actual",
        "suggested_fix"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKER"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "expected": {
          "type": [
            "null",
            "boolean",
            "object",
            "array",
            "number",
            "string"
          ]
        },
        "actual": {
          "type": [
            "null",
            "boolean",
            "object",
            "array",
            "number",
            "string"
          ]
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
