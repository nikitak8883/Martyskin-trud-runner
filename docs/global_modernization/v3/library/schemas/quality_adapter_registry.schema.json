{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mtr.local/quality/v1/quality-adapter-registry.schema.json",
  "title": "MTR quality evidence adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "namespace",
    "registry_version",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "mtr.quality_adapter_registry"
    },
    "namespace": {
      "const": "https://schemas.mtr.local/quality/v1/"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/adapter_entry"
      }
    }
  },
  "$defs": {
    "adapter_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_schema",
        "source_version",
        "support",
        "target_platform",
        "detection",
        "migration_rule",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mtr\\.quality_adapter\\.[a-z0-9_]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "source_schema": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "active",
            "historical_only",
            "data_not_quality_evidence"
          ]
        },
        "target_platform": {
          "enum": [
            "source",
            "static",
            "web",
            "android-emulator",
            "mixed"
          ]
        },
        "handler": {
          "type": "string",
          "pattern": "^adapt_[a-z0-9_]+$"
        },
        "detection": {
          "type": "string",
          "minLength": 1
        },
        "strict_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration_rule": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "support": {
                "const": "active"
              }
            }
          },
          "then": {
            "required": [
              "handler",
              "strict_requirements"
            ]
          }
        }
      ]
    }
  }
}
