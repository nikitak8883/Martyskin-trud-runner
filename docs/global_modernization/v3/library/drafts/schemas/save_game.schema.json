{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTR Save Envelope",
  "type": "object",
  "required": [
    "saveSchemaVersion",
    "profileId",
    "updatedAt",
    "payload"
  ],
  "properties": {
    "saveSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "checksum": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
