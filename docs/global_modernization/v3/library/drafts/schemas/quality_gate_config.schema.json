{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTR Quality Gate Config",
  "type": "object",
  "required": [
    "schemaVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "mandatory"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "workingDirectory": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
