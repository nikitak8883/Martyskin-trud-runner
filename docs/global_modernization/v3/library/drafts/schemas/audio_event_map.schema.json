{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTR Audio Event Map",
  "type": "object",
  "required": [
    "schemaVersion",
    "buses",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "buses": {
      "type": "array",
      "items": {
        "enum": [
          "UI",
          "SFX",
          "MonkeyVoice",
          "Ambience",
          "Music"
        ]
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "bus",
          "asset"
        ],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "bus": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 0
          },
          "priority": {
            "type": "integer"
          },
          "maxSimultaneous": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
