{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTR Release Gate Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "sourceCommit",
    "contentVersion",
    "status",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string"
    },
    "contentVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mandatory",
          "status",
          "exitCode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "BLOCKED"
            ]
          },
          "exitCode": {
            "type": "integer"
          },
          "command": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "report": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
