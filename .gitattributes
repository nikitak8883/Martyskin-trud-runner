/tools/codex/build_source_content_manifest.py text eol=lf

# Cross-platform quality evidence must keep one byte identity on every runner.
/.github/workflows/** text eol=lf
/docs/global_modernization/v3/library/** text eol=lf
/tools/codex/evidence-retention/** text eol=lf
/tools/codex/quality-gate/** text eol=lf
