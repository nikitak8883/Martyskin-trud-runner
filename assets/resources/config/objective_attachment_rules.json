{
  "schema_version": 1,
  "categories": {
    "platforms": {
      "runtime_path": "assets/resources/objectives/themed/last_iteration/*/platforms",
      "attach_to": "gameplay_ground_or_platform_root",
      "zGroup": "platforms",
      "collider": "BoxCollider2D",
      "opacity_range": [0.72, 0.92],
      "rule": "Only platform contact edge may be visually strong. Decorative body must not hide player."
    },
    "hazards": {
      "runtime_path": "assets/resources/objectives/themed/last_iteration/*/hazards",
      "attach_to": "hazard_root",
      "zGroup": "hazards",
      "collider": "BoxCollider2D_or_PolygonCollider2D",
      "opacity_range": [0.9, 1.0],
      "rule": "Must read faster than decor but not cover player unfairly."
    },
    "bonuses": {
      "runtime_path": "assets/resources/objectives/bonuses",
      "attach_to": "collectible_root",
      "zGroup": "collectibles",
      "collider": "CircleCollider2D",
      "opacity_range": [0.9, 1.0],
      "rule": "Must be readable but less visually dominant than player."
    },
    "npc_decor": {
      "runtime_path": "assets/resources/objectives/npc_decor",
      "attach_to": "midground_or_foreground_decor_root",
      "zGroup": "background_signage",
      "collider": "none_or_trigger_only",
      "opacity_range": [0.35, 0.75],
      "rule": "NPC decor must enrich level, not compete with player."
    },
    "labels_signage": {
      "runtime_path": "assets/resources/objectives/signage",
      "attach_to": "label_root",
      "zGroup": "active_labels",
      "collider": "none",
      "opacity_range": [0.65, 0.9],
      "rule": "Gameplay labels short and readable; background jokes dim."
    },
    "ui_achievements": {
      "runtime_path": "assets/resources/objectives/ui_achievements",
      "attach_to": "ui_root",
      "zGroup": "modal_overlay",
      "collider": "none",
      "opacity_range": [1.0, 1.0],
      "rule": "Do not use noisy gameplay textures as achievement card backgrounds."
    },
    "foreground_decor": {
      "runtime_path": "assets/resources/objectives/foreground_decor",
      "attach_to": "foreground_root",
      "zGroup": "gameplay_ground",
      "collider": "none_or_trigger_only",
      "opacity_range": [0.25, 0.68],
      "rule": "Foreground decor adds depth but must never hide the player's body or platform contact edge."
    },
    "background_decor": {
      "runtime_path": "assets/resources/objectives/background_decor",
      "attach_to": "background_root",
      "zGroup": "background_signage",
      "collider": "none",
      "opacity_range": [0.2, 0.62],
      "rule": "Background decor supports the story and stays behind gameplay readability bands."
    }
  },
  "required_logs": [
    "MTR_ASSET_USAGE",
    "MTR_ASSET_USAGE_SUMMARY"
  ]
}
