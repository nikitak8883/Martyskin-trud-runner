{
  "schemaVersion": 1,
  "policy": {
    "interactiveText": "runtime-label-preferred",
    "bakedTextAllowed": "documented-atomic-interactive-exceptions",
    "legacyUiRuntimeAllowed": false,
    "atomicBakedInteractiveExceptions": [
      {
        "screen": "menu",
        "reason": "Main menu buttons are single atomic PNG buttons with baked Russian labels; GameRoot returns before drawing a runtime label to prevent ghost under-text.",
        "labels": [
          "НАЧАТЬ ИГРУ",
          "ВПЕРЁД, ПРИМАТЫ!",
          "ВЫБЕРИ СВОЕГО ПРИМАТА",
          "ЗВУК И НАСТРОЙКИ",
          "МАРТЫШКИНЫ РЕКОРДЫ",
          "ВЫБОР УРОВНЯ",
          "РЕЖИМ РАЗРАБОТЧИКА"
        ]
      },
      {
        "screen": "name",
        "reason": "Start name submenu uses a unified PNG button pack. Runtime EditBox text is hidden and mirrored by Cocos labels to avoid duplicate DOM and Cocos labels.",
        "labels": [
          "СОХРАНИТЬ ИМЯ",
          "ВПЕРЁД, ПРИМАТЫ!",
          "В МЕНЮ"
        ]
      }
    ]
  },
  "shared": {
    "titleBanner": "ui/shared/banners/title_banner_blank",
    "buttonPrimary": "ui/shared/buttons/button_primary_idle",
    "buttonPressed": "ui/shared/buttons/button_primary_pressed",
    "buttonSecondary": "ui/shared/buttons/button_secondary_idle",
    "buttonBack": "ui/shared/buttons/button_back_idle",
    "buttonDanger": "ui/shared/buttons/button_danger_idle",
    "buttonDisabled": "ui/shared/buttons/button_disabled",
    "buttonCompact": "ui/shared/buttons/button_compact_idle",
    "panelMain": "ui/shared/panels/panel_main",
    "panelDialog": "ui/shared/panels/panel_dialog",
    "panelList": "ui/shared/panels/panel_list",
    "panelChip": "ui/shared/panels/panel_chip",
    "statusChip": "ui/shared/cards/status_chip"
  },
  "cards": {
    "level": "ui/shared/cards/level_card_idle",
    "levelSelected": "ui/shared/cards/level_card_selected",
    "levelLocked": "ui/shared/cards/level_card_locked",
    "primate": "ui/shared/cards/primate_card_idle",
    "primateSelected": "ui/shared/cards/primate_card_selected",
    "achievement": "ui/shared/cards/achievement_card",
    "achievementLocked": "ui/shared/cards/achievement_card_locked",
    "emptyState": "ui/shared/cards/empty_state_card"
  },
  "controls": {
    "sliderTrack": "ui/shared/controls/slider_track",
    "sliderFill": "ui/shared/controls/slider_fill",
    "sliderKnob": "ui/shared/controls/slider_knob",
    "toggleOn": "ui/shared/controls/toggle_on",
    "toggleOff": "ui/shared/controls/toggle_off"
  },
  "hud": {
    "panel": "ui/shared/cards/hud_panel",
    "control": "ui/shared/cards/hud_control"
  }
}
