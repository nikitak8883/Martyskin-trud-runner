{
  "schemaVersion": 1,
  "fontPolicy": "Cocos system font with Cyrillic support and runtime outline",
  "title": {
    "fontSize": 38,
    "color": "#FFE27A",
    "outlineColor": "#301C0C",
    "outlineWidth": 3,
    "maxLines": 1
  },
  "button": {
    "fontSize": 20,
    "color": "#FFF4CC",
    "outlineColor": "#2A180A",
    "outlineWidth": 2,
    "maxLines": 2
  },
  "body": {
    "fontSize": 18,
    "color": "#F6ECCC",
    "outlineColor": "#1E150E",
    "outlineWidth": 1
  },
  "caption": {
    "fontSize": 13,
    "color": "#E0DBBC",
    "outlineColor": "#18120C",
    "outlineWidth": 1
  },
  "date": {
    "locale": "ru-RU",
    "format": "dd.MM.yyyy"
  }
}
