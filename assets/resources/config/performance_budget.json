{
  "schemaVersion": 1,
  "targetDeviceClass": "Samsung Galaxy S25 Ultra or equivalent",
  "android": {
    "package": "com.martyskin.trudrunner",
    "activity": "com.cocos.game.AppActivity",
    "targetFps": 60,
    "requiredQa": [
      "cold_start",
      "5_minute_gameplay",
      "10_restarts",
      "gfxinfo_before_after",
      "meminfo_before_after",
      "logcat_errors",
      "pause_30_tap_acceptance"
    ]
  },
  "web": {
    "targetBrowsers": [
      "Chrome Android",
      "Safari iPad",
      "Desktop Chromium"
    ],
    "targetFps": 60,
    "mustNotShowDebugOverlays": true
  }
}
